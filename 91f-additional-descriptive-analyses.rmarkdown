#| fig-height: 5
#| fig-width: 12

vagina_tests |>
  filter(!is.na(whiff_test)) |>
  filter(randomized) |>
  ggplot() +
  aes(y = visit_code, x = pid, color = whiff_test) +
  geom_point() +
  facet_wrap(~site, scales = "free_x", space = "free_x") +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(angle = 90, hjust = 1)
  ) +
  labs(
    title = "Vaginal whiff test results",
    subtitle = "Vaginal whiff test values by visit code and randomized participant",
    y = "Visit code",
    x = "Participant",
    color = "Whiff test"
  )
```

### STI results

# Saving the `MultiAssayExperiment` objects

We save the MAE for downstream analyses.

```{r}
#| eval: true

saveRDS(
  mae,
  str_c(
    get_03_output_dir(),
    "mae_full_06_",
    today() |> str_remove_all("-"),
    ".rds"
  )
)
```




Most samples seem to have "Negative" values of leukocyte concentration in the urine, and the rest of the values are distributed across the different levels of leukocyte concentration in the urine. With a high proportion of "Trace" and "1+" values of leukocyte concentration in the urine. We document below samples for which leukocyte concentration in the urine is higher or equal than "Trace", by visit code and participant.

```{r}
#| fig-height: 6
#| fig-width: 12

urinalysis |>
  filter(!is.na(leucocytes)) |>
  filter(leucocytes == "Trace") |>
  select(
    pid,
    study_day,
    visit_code,
    randomized,
    visit_type,
    site,
    leucocytes
  ) |>
  ggplot() +
  aes(y = visit_code, x = pid, shape = randomized) +
  geom_point(color = "dodgerblue") +
  scale_shape_manual(values = c(1, 16)) +
  theme(legend.position = "bottom", axis.text.x = element_text(angle = 90)) +
  labs(
    title = "Leukocyte results",
    subtitle = "Participants with Trace values of leukocyte concentration in the urine in the urinal data, \nby visit code and participant",
    y = "Visit code",
    x = "Participant"
  ) +

  urinalysis |>
    filter(!is.na(leucocytes)) |>
    filter(leucocytes == "1+") |>
    select(
      pid,
      study_day,
      visit_code,
      randomized,
      visit_type,
      site,
      leucocytes
    ) |>
    ggplot() +
  aes(y = visit_code, x = pid, shape = randomized) +
  geom_point(color = "orange") +
  scale_shape_manual(values = c(1, 16)) +
  theme(legend.position = "bottom", axis.text.x = element_text(angle = 90)) +
  labs(
    subtitle = "Participants with 1+ values of leukocyte concentration in the urine in the urinal data, \nby visit code and participant",
    y = "Visit code",
    x = "Participant"
  ) +

  patchwork::plot_layout(ncol = 1, guides = "collect") &
  theme(legend.position = "bottom")
```


```{r}
#| fig-height: 6
#| fig-width: 7

urinalysis |>
  filter(!is.na(leucocytes)) |>
  filter(leucocytes == "2+") |>
  select(
    pid,
    study_day,
    visit_code,
    randomized,
    visit_type,
    site,
    leucocytes
  ) |>
  ggplot() +
  aes(y = visit_code, x = pid, shape = randomized) +
  geom_point(color = "pink2") +
  scale_shape_manual(values = c(1, 16)) +
  theme(legend.position = "bottom", axis.text.x = element_text(angle = 90)) +
  labs(
    title = "Leukocyte results",
    subtitle = "Participants with 2+ of leukocyte concentration in the urine in the urinal data, \nby visit code and participant",
    y = "Visit code",
    x = "Participant"
  ) +

  urinalysis |>
    filter(!is.na(leucocytes)) |>
    filter(leucocytes == "3+") |>
    select(
      pid,
      study_day,
      visit_code,
      randomized,
      visit_type,
      site,
      leucocytes
    ) |>
    ggplot() +
  aes(y = visit_code, x = pid, shape = randomized) +
  geom_point(color = "red3") +
  scale_shape_manual(values = c(1, 16)) +
  theme(legend.position = "bottom", axis.text.x = element_text(angle = 90)) +
  labs(
    subtitle = "Participants with 3+ values of leukocyte concentration in the urine, \nby visit code and participant",
    y = "Visit code",
    x = "Participant"
  ) +

  patchwork::plot_layout(ncol = 1, guides = "collect") &
  theme(legend.position = "right")
```


```{r}
